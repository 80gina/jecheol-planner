{
  "project_name": "제철밥상 플래너",
  "description": "지역별 제철 식재료 트렌드 + 가격 + 맞춤 요리 추천",

  "news_db": "../bapsang-trend/data/bapsang.db",

  "home_region": {
    "name": "경남",
    "market_city": "창원",
    "kamis_country_code": ""
  },

  "compare_regions": [
    {"name": "전국(평균)", "kamis_country_code": "1101"}
  ],

  "kamis": {
    "base_url": "http://www.kamis.or.kr/service/price/xml.do",
    "product_cls": {"소매": "01", "도매": "02"},
    "convert_kg": "N",
    "cache_hours": 12
  },

  "ai": {
    "model": "gemini-3.5-flash-lite",
    "fallback_models": ["gemini-3.1-flash-lite"],
    "max_input_chars": 6000
  },

  "class_defaults": {
    "people": 12,
    "sessions": 4,
    "budget_per_person": 8000,
    "difficulty": "초급",
    "minutes": 90
  },

  "request": {
    "timeout_sec": 15,
    "delay_sec": 0.7,
    "max_retry": 3,
    "user_agent": "JecheolPlanner/1.0 (educational; contact: 80gina@gmail.com)"
  },

  "paths": {
    "db": "data/planner.db",
    "output_dir": "output",
    "log_file": "logs/app.log"
  }
}
